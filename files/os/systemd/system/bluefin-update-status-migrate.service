[Unit]
Description=Enable the 80-bluefin-updates preset on nodes that updated into this image
Documentation=file:/usr/libexec/bluefin-update-status-migrate
# Apply the latest 80-bluefin-updates preset to every unit it enables for
# nodes that sysupd-into an image where the preset added or changed a rule
# (projectbluefin/server#366, projectbluefin/server#367).
# system-preset only runs on first boot (Ignition calls `systemctl preset-all`
# for /etc systemd and /usr factory presets on a fresh install), so a node
# that sysupds into an image with a new `enable bluefin-*.service` line
# never evaluates it.  Without this migration, units like
# bluefin-update-status.service stay disabled on nodes that updated into
# the image, and /run/motd / /run/issue.d stay empty until the next
# systemd-sysupdate.service run triggers bluefin-update-status.service via
# OnSuccess=/OnFailure=.
# Runs once per node (stamp in ConditionPathExists=!), so it does not
# fork a shell on every boot after the first.
ConditionPathExists=!/var/lib/bluefin/update-status-migrate.stamp
# Run before anything reads the banners; tmpfiles is what makes /etc/motd a
# link into /run/motd, and the units we enable write /run/motd.
After=systemd-tmpfiles-setup.service
Before=systemd-user-sessions.service getty.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/bluefin-update-status-migrate

[Install]
WantedBy=multi-user.target