#!/usr/bin/bash
# bluefin-update-status-migrate — run once per installed node by
# bluefin-update-status-migrate.service.
#
# Presets apply on first boot only, so a node that updated from an image
# without bluefin-update-status.service never enables it and its login
# banners stay empty (projectbluefin/server#367). Enable it from its preset
# rule and start it so the banners show on this boot. Nothing else in
# 80-bluefin-updates.preset is touched: re-applying the update timers would
# undo an operator's opt-out.
set -euo pipefail

systemctl="${BLUEFIN_SYSTEMCTL:-systemctl}"
stamp="${BLUEFIN_UPDATE_STATUS_MIGRATE_STAMP:-/var/lib/bluefin/update-status-migrate.stamp}"
unit=bluefin-update-status.service

if "${systemctl}" is-enabled --quiet "${unit}"; then
    echo "bluefin-update-status-migrate: ${unit} already enabled"
else
    # Honours an operator preset (e.g. Ignition's) that disables it.
    "${systemctl}" preset "${unit}" || :
    if "${systemctl}" is-enabled --quiet "${unit}"; then
        "${systemctl}" start --no-block "${unit}" || :
        echo "bluefin-update-status-migrate: enabled ${unit}"
    else
        echo "bluefin-update-status-migrate: ${unit} left disabled by preset"
    fi
fi

mkdir -p "${stamp%/*}"
: >"${stamp}"
